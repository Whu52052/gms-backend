# ============================================================
#  GMS 环境变量配置模板
#  使用方法：复制为 .env 并填入真实值。切勿提交 .env 到版本库！
# ============================================================

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme_strong_password
DB_NAME=gms
# 仅 docker-compose MySQL 容器初始化用（与 DB_PASSWORD 可相同或更强）
DB_ROOT_PASSWORD=changeme_root_password

# ---------- Redis (可选，缺失则纯内存模式) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 完整 URL 形式（优先级高于 HOST/PORT）
REDIS_URL=redis://127.0.0.1:6379

# ---------- Server ----------
PORT=8765
# HTTPS 标志：true 时下发 HSTS 头（仅 HTTPS 部署设为 true）
HTTPS_ENABLED=false
# 跨域允许来源（收紧 CORS 用，留空则不返回 ACAO 头=同源策略）
CORS_ORIGIN=

# ---------- 安全 ----------
# encryptPassword 的加密密钥（S6 批次将改用随机 IV）
ENCRYPTION_KEY=change_to_random_32_byte_hex
# CSRF 校验密钥（S4 批次启用）
CSRF_SECRET=change_to_random_string
# CSRF 默认强制校验；仅临时兼容旧客户端时显式设为 false
CSRF_ENFORCED=true

# ---------- 飞书集成 (SZX3 多维表格 + 运维通知群) ----------
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_APP_TOKEN=your_bitable_app_token
FEISHU_TABLE_ID=tblxxxxxxxx
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id

# ---------- 可选 ----------
# 出站代理（飞书 API 走代理时设置）
HTTPS_PROXY=
# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# ---------- 边缘代理（machine-heartbeat-agent） ----------
# 每台机器上的心跳 agent 用此 token 上报（Bearer 认证）；留空则拒绝所有边缘接入
# 生成：openssl rand -hex 24
EDGE_TOKEN=
# 故障类告警自动创建技术支持工单：on（默认）/ off
# 默认对：左右手接反 / SN 状态不可用 / 设备串用 / SN 未登记 自动建单
EDGE_AUTO_TICKET=on
# 追加需要自动建单的告警码（逗号分隔），可选：
#   bound_but_disconnected（绑定手套未连接，下班关机易误报）
#   glove_no_sn（手套已连接但识别不到 SN，可能仅缺标定文件）
EDGE_AUTO_TICKET_EXTRA=
# 自动工单提交人（用户表 users.id），默认 sa-002 运营系统账号
EDGE_TICKET_SUBMITTER_ID=sa-002
