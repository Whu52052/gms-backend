# 复制为 .env 后修改（docker compose 会自动读取同目录 .env）
# 边缘接入令牌：必须与 GMS 服务端 .env 的 EDGE_TOKEN 完全一致
# 生成方法：openssl rand -hex 24
EDGE_TOKEN=
# GMS 中心地址（默认值已内置，跨网段部署时修改）
# GMS_BACKEND_URL=http://10.5.51.216:8765
# 机器编号（留空则从 hostname we-xxx 自动检测）
# MACHINE_NUMBER=we-100
# 采集机本地只读 API（host 网络下默认访问宿主机）
# IMPORTER_API_URL=http://127.0.0.1:5025
# HERMES_API_URL=http://127.0.0.1:5006
# 单个采集 API 请求超时（毫秒）
# COLLECTOR_API_TIMEOUT=3000
